<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Batas visibilitas paket: hanya aplikasi peluncur yang perlu dibaca
         untuk layar pengecualian, tanpa izin QUERY_ALL_PACKAGES yang dibatasi. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Baris "Selalu aktif" membuka layar pengaturan VPN sistem; tanpa deklarasi
             berikut, resolusi intent bisa gagal pada API 30+ karena pembatasan
             visibilitas paket (aplikasi tidak "melihat" aplikasi Pengaturan). -->
        <intent>
            <action android:name="android.settings.VPN_SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Velum"
        tools:ignore="GoogleAppIndexingWarning">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppExclusionActivity"
            android:exported="false"
            android:label="@string/title_excluded" />

        <!-- Ubin pengaturan cepat: sambung/putus tanpa membuka aplikasi (API 24+). -->
        <service
            android:name=".VelumTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Sambung ulang otomatis setelah boot DAN setelah aplikasi diperbarui (hanya bila
             terakhir UP & izin VPN berlaku). MY_PACKAGE_REPLACED perlu karena pembaruan
             mematikan proses, dan proses yang mati berarti tunnel ikut mati. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- VpnService milik library WireGuard; menjalankan tunnel Go di dalam proses aplikasi.

             SENGAJA tanpa `android:foregroundServiceType` dan tanpa izin FOREGROUND_SERVICE*.
             Buktinya, bukan dugaan: tidak ada satu pun pemanggilan `startForeground()` —
             nol di aplikasi ini, dan nol di `GoBackend.java` pada sumber upstream tag
             1.0.20260102 (library memulai layanan dengan `Context.startService` lalu
             menunggu 2 detik, tanpa pernah mempromosikannya). Manifest library sendiri
             juga tidak mendeklarasikan tipe apa pun, jadi atribut itu sepenuhnya berasal
             dari repo ini. Sistem hanya memeriksa tipe SAAT `startForeground()` dipanggil
             (`MissingForegroundServiceTypeException`), sehingga deklarasi itu inert — dan
             menyatakan `specialUse` yang tidak dipakai justru menuntut pembenaran di Play
             Console untuk sesuatu yang tidak ada.

             Catatan: Android mendokumentasikan bahwa aplikasi VPN yang dimulai di latar
             harus mempromosikan VpnService ke foreground. Versi library ini tidak memanggil
             `startForeground()`, sehingga ketahanan terhadap pembunuhan proses oleh vendor
             perangkat tidak dapat dijamin hanya dari manifest. `stopWithTask=false` di bawah
             mencegah sistem menghentikan service semata-mata karena task di-swipe, tetapi
             pengujian pada perangkat nyata tetap wajib. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:exported="false"
            android:stopWithTask="false"
            tools:node="merge"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>
    </application>
</manifest>
